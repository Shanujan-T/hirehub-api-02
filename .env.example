DB_USER=root

DB_PASSWORD=your_password

DB_HOST=127.0.0.1

# Use one database name locally and stick with it (e.g. hirehub or localjobfinder).
# The API always loads this file from hirehub-api-02/.env, regardless of cwd.
DB_NAME=hirehub

# Railway production database (required for data to survive API redeploys):
# 1. Add a MySQL service with a persistent Volume in the same Railway project.
# 2. In the API service's Variables tab, reference the MySQL service rather than
#    entering a one-off URL, for example:
#    DATABASE_URL=${{MySQL.MYSQL_URL}}
#    (replace "MySQL" with the exact Railway database service name).
# Do not use localhost or a database created inside the API service on Railway.

JWT_SECRET_KEY=change-me-to-a-long-random-string

JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1440

FLASK_DEBUG=0

PORT=5000

CLOUDINARY_CLOUD_NAME=your_cloud_name

CLOUDINARY_API_KEY=your_api_key

CLOUDINARY_API_SECRET=your_api_secret


# OpenRouter free tier — used for AI assists (openrouter/free auto-router).
# Get a free key at https://openrouter.ai/keys (no credit card required for free models).
# Leave blank to disable AI features.
OPENROUTER_API_KEY=

# Suggested-price web fallback. Used only when the selected category has no
# matching rows in Sri_Lanka_Service_Pricing_Dataset.csv.
BRAVE_SEARCH_API_KEY=
ANTHROPIC_API_KEY=
# Optional: defaults to Claude Haiku 4.5.
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001

# Optional in-process Monday 09:00 weekly digest job (set ENABLE_WEEKLY_DIGEST_SCHEDULER=true)
ENABLE_WEEKLY_DIGEST_SCHEDULER=false

# Apify token for Numbeo COL scraper (https://console.apify.com/account/integrations)
# Used by: python -m app.scripts.fetch_district_col_index
APIFY_TOKEN=
# Optional override (default: automation-lab/numbeo-scraper)
APIFY_NUMBEO_ACTOR=automation-lab/numbeo-scraper
# Treat city indexes with fewer contributors than this as unreliable (province/national fallback)
NUMBEO_MIN_CONTRIBUTORS=10
# Seconds between per-city Apify runs (free-tier friendly)
APIFY_CITY_BATCH_PAUSE_S=2
# Optional monthly refresh of district COL multipliers + re-seed of estimate rows
ENABLE_COL_INDEX_SCHEDULER=false

# Twilio Verify SMS Config
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Brevo transactional email config. The sender address must be verified in Brevo.
BREVO_API_KEY=
BREVO_FROM_EMAIL=verified-sender@example.com
BREVO_FROM_NAME=HireHub
