DB_USER=root

DB_PASSWORD=your_password

DB_HOST=127.0.0.1

# Use one database name locally and stick with it (e.g. hirehub or localjobfinder).
# The API always loads this file from hirehub-api-02/.env, regardless of cwd.
DB_NAME=hirehub

# Railway: link a MySQL plugin or set DATABASE_URL / MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE

JWT_SECRET_KEY=change-me-to-a-long-random-string

JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1440

FLASK_DEBUG=0

PORT=5000

CLOUDINARY_CLOUD_NAME=your_cloud_name

CLOUDINARY_API_KEY=your_api_key

CLOUDINARY_API_SECRET=your_api_secret

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NIC_ENCRYPTION_KEY=your_fernet_key_here

# Anthropic Claude (Haiku) — used for AI bid/job/match/review assists. Leave blank to disable AI features.
ANTHROPIC_API_KEY=

